<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dao.RouteMapper">

    <insert id="insertRoute" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO routes (total_time, is_fastest)
        VALUES (#{totalTime}, #{fastest})
    </insert>

    <insert id="insertRoutePoint">
        INSERT INTO route_points (route_id, point_id, position)
        VALUES (#{routeId}, #{pointId}, #{position})
    </insert>

    <resultMap id="routeMap" type="model.Route">
        <id     property="id"        column="r_id"/>
        <result property="totalTime" column="total_time"/>
        <result property="fastest"   column="is_fastest"/>
        <collection property="points" ofType="model.Point">
            <id     property="id" column="p_id"/>
            <result property="x"  column="x"/>
            <result property="y"  column="y"/>
        </collection>
    </resultMap>

    <select id="findAllWithPoints" resultMap="routeMap">
        SELECT r.id    r_id,
        r.total_time,
        r.is_fastest,
        p.id    p_id,
        p.x,
        p.y
        FROM   routes r
        JOIN   route_points rp ON rp.route_id = r.id
        JOIN   points       p  ON p.id = rp.point_id
        ORDER  BY r.id, rp.position
    </select>

    <select id="findById" resultMap="routeMap">
        SELECT r.id    r_id,
        r.total_time,
        r.is_fastest,
        p.id    p_id,
        p.x,
        p.y
        FROM   routes r
        JOIN   route_points rp ON rp.route_id = r.id
        JOIN   points       p  ON p.id = rp.point_id
        WHERE  r.id = #{id}
        ORDER  BY rp.position
    </select>

</mapper>
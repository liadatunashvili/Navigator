<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dao.PointMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO points (x, y) VALUES (#{x}, #{y})
    </insert>

    <select id="findAll" resultType="model.Point">
        SELECT id, x, y FROM points
    </select>

    <select id="findById" resultType="model.Point">
        SELECT id, x, y FROM points WHERE id = #{id}
    </select>

    <delete id="deleteAll">
        DELETE FROM points
    </delete>

</mapper>